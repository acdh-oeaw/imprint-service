{
	"$schema": "https://www.schemastore.org/package",
	"name": "@acdh-oeaw/imprint-service",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"build": "bun build --target=bun --outfile=index.js ./src/index.ts",
		"dev": "bun run --hot src/index.ts | pino-pretty",
		"format:check": "bun fmt --check",
		"format:fix": "bun fmt",
		"lint:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"test": "bun test",
		"types:check": "bun check"
	},
	"dependencies": {
		"@hono/structured-logger": "^1.0.0",
		"hono": "^4.13.19",
		"pino": "^10.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"lefthook": "^2.2.2",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"pino-pretty": "^13.2.0",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.4.5",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.4.5",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.4.5",
			"onFail": "download"
		}
	}
}
