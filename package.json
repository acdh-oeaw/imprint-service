{
	"$schema": "https://www.schemastore.org/package",
	"name": "@acdh-oeaw/imprint-service",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"build": "bun build --target=bun --outfile=index.js ./src/index.ts",
		"dev": "bun run --hot src/index.ts | pino-pretty",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"test": "bun test src/index.test.ts",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/validate-env": "^0.2.1",
		"hono": "^4.13.8",
		"hono-pino": "^0.10.3",
		"pino": "^10.3.1",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"templite": "^1.2.0",
		"unified": "^11.0.5",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"lefthook": "^2.1.14",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pino-pretty": "^13.1.3",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "download"
		}
	}
}
