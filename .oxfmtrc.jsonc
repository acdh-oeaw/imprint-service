{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["content/"],
	"jsdoc": true,
	"printWidth": 100,
	"sortImports": {
		"groups": [["side_effect"], ["builtin"], ["external"], ["internal", "subpath"], ["unknown"]],
	},
	"sortPackageJson": {
		"sortScripts": true,
	},
	"useTabs": true,
}
