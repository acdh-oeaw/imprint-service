{
	"$schema": "./node_modules/lefthook/schema.json",
	"pre-commit": {
		"commands": {
			"oxlint": {
				"run": "bun oxlint --fix --no-error-on-unmatched-pattern --report-unused-disable-directives --type-aware --type-check {staged_files}",
				"stage_fixed": true
			},
			"fmt": {
				"run": "bun fmt --staged"
			}
		}
	}
}
